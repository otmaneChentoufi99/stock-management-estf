<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" prefWidth="900" prefHeight="700" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ma.estf.magasiner.controllers.AffectationConsumableManageController"
      style="-fx-background-color: #f8f9fa;">
    
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Header Section -->
    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label fx:id="titleLabel" text="Détails de l'Affectation (Consommable)" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #2c3e50;"/>
            <HBox spacing="20">
                <Label fx:id="beneficiaryLabel" text="Bénéficiaire: " style="-fx-text-fill: #7f8c8d;"/>
                <Label fx:id="dateLabel" text="Date: " style="-fx-text-fill: #7f8c8d;"/>
            </HBox>
        </VBox>
    </HBox>

    <VBox spacing="10" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 10;">
        <Label text="Articles de cette affectation" style="-fx-font-weight: bold; -fx-text-fill: #34495e;"/>
        <TableView fx:id="itemsTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colRef" text="Référence" prefWidth="120"/>
                <TableColumn fx:id="colName" text="Désignation" prefWidth="250"/>
                <TableColumn fx:id="colQuantity" text="Qté" prefWidth="80"/>
                <TableColumn fx:id="colInventory" text="N° Inv" prefWidth="150"/>
                <TableColumn fx:id="colCondition" text="État" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
